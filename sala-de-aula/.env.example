# Chave da API Gemini (Google AI Studio → https://aistudio.google.com/apikey)
# Fica SOMENTE no servidor. Nunca coloque esta chave no código do navegador.
GEMINI_API_KEY=

# Opcional: identificadores dos modelos. Se ficarem vazios, o servidor consulta
# a lista real de modelos da sua chave e escolhe o primeiro compatível.
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
# Nano Banana Pro (não há substituição automática por outro modelo de imagem)
GEMINI_IMAGE_MODEL=

# Senha para entrar no site. OBRIGATÓRIA quando o site fica na internet
# (no Render ou com HOST=0.0.0.0). No computador local pode ficar vazia.
APP_PASSWORD=

# Porta e endereço (no Render são definidos automaticamente).
PORT=5173
HOST=127.0.0.1
